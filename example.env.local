# Frontend
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Convex (set via `npx convex env set`)
# ALLOW_SIGNUP=true             # extra accounts after the first; omit on a locked deploy
# GOOGLE_CLOUD_PROJECT_ID=      # service account JSON "project_id"
# GOOGLE_APPLICATION_CREDENTIALS_JSON=  # full service account JSON string
# GCP: enable Cloud Translation API + grant service account "Cloud Translation API User"
# ELEVENLABS_API_KEY=
# JWT_PRIVATE_KEY=
# SITE_URL=http://localhost:3000
